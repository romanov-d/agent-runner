# Подключение к базе. Воркер и тесты берут строку отсюда.
DATABASE_URL=postgres://runner:runner@localhost:5433/runner

# Сколько задач воркер держит одновременно.
CONCURRENCY=4

# Имя воркера в журнале. Если пусто - берётся hostname и pid.
WORKER_ID=

# Провайдер модели: fake (детерминированная заглушка) или anthropic.
MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=
